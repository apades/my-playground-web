{
  "compilerOptions": {
    "paths": {
      "@root/*": [
        "./src/*"
      ],
      "@pkgs/*": [
        "./packages/*"
      ],
      "@style/*": [
        "./style/*"
      ],
      "@utils/*": [
        "./utils/*"
      ]
    },
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "./src/**/*",
    "./scripts/**/*",
    "./style/**/*",
    "./packages/**/*",
    "./e2e/**/*",
    "./vite.config.ts",
    "./tailwind.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}